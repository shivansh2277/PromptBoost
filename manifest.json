{
  "manifest_version": 3,
  "name": "PromptBoost - AI Prompt Improver",
  "version": "11.0.0",
  "description": "Improve and structure prompts directly inside ChatGPT before submitting.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "improve-prompt": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Improve the current ChatGPT prompt"
    }
  },
  "action": {
    "default_title": "PromptBoost"
  }
}
